{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perfumeday",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-14",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perfumeday",
      "database_id": "50e2508d-4a25-4d4c-aa07-0f19db39bb1e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  "vars": {
    "DEFAULT_TIMEZONE": "Asia/Singapore",
    "DEFAULT_LATITUDE": "1.3521",
    "DEFAULT_LONGITUDE": "103.8198",
    "REQUIRE_ACCESS": "true",
    "TEAM_DOMAIN": "https://chuabohao.cloudflareaccess.com",
    "POLICY_AUD": "fb7737711c542b50ea7e80b51e90764460d4f5748a7662d54f638a6f4e056ad3",
    "AI_MODEL": "claude-sonnet-4-5"
  }
}
